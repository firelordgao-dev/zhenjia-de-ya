page {
  background: #f4f5ef;
  color: #121815;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 36rpx;
  overflow-x: hidden;
}

view, text, image, textarea, label, checkbox {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  white-space: normal;
  overflow: hidden;
  word-break: break-word;
}

button::after {
  border: 0 !important;
  content: "" !important;
  display: none !important;
}

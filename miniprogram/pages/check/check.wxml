<view class="check-page">
  <view class="page-head">
    <button class="ghost-button" bindtap="callPolice">110</button>
    <view class="head-copy">
      <view class="head-title">先别转钱</view>
      <view class="head-subtitle">把聊天、短信或截图放进来，马上帮你判断。</view>
    </view>
  </view>

  <view class="activity-ribbon">
    <text class="ribbon-label">公益活动提醒</text>
    <text class="ribbon-text">看见转账、验证码、共享屏幕，先停 30 秒。</text>
  </view>

  <view wx:if="{{urgentGuide}}" class="urgent-card">
    <view class="urgent-top">
      <view>
        <view class="eyebrow">先止损</view>
        <view class="urgent-title">{{urgentGuide.title}}</view>
      </view>
      <view class="urgent-badge">现在做</view>
    </view>
    <view class="urgent-summary">{{urgentGuide.summary}}</view>
    <view class="urgent-steps">
      <view wx:for="{{urgentGuide.steps}}" wx:key="*this" class="step-row">
        <text class="step-number">{{index + 1}}</text>
        <text>{{item}}</text>
      </view>
    </view>
    <view class="urgent-actions">
      <view class="danger-button" bindtap="callPolice">拨打 110</view>
      <view class="plain-button" bindtap="copyUrgentGuide">复制给家人</view>
    </view>
  </view>

  <view class="panel primary-intake">
    <view class="panel-header">
      <view>
        <view class="panel-title">第一步：放入可疑内容</view>
        <view class="panel-note">复制来的话、短信、聊天截图都可以。</view>
      </view>
      <view class="small-button subtle-button" bindtap="loadSample">看示例</view>
    </view>

    <view class="quick-actions">
      <view class="quick-action paste-action" bindtap="pasteFromClipboard">
        <text class="quick-icon">文</text>
        <view>
          <view class="quick-title">粘贴文字</view>
          <view class="quick-subtitle">复制后点这里</view>
        </view>
      </view>
      <view class="quick-action image-action" bindtap="chooseScreenshot">
        <text class="quick-icon">图</text>
        <view>
          <view class="quick-title">上传截图</view>
          <view class="quick-subtitle">聊天、短信、付款页</view>
        </view>
      </view>
    </view>

    <textarea class="case-textarea" value="{{caseText}}" bindinput="onTextInput" placeholder="也可以直接在这里输入。比如：对方说我是客服，要退款，让我点链接、填银行卡，还要验证码。" maxlength="-1" auto-height="{{false}}" />

    <view wx:if="{{imagePaths.length}}" class="image-summary">
      <text>已选 {{imagePaths.length}} 张截图</text>
      <text>点图片可删除</text>
    </view>
    <view wx:if="{{imagePaths.length}}" class="image-grid">
      <view wx:for="{{imagePaths}}" wx:key="*this" wx:for-index="idx" class="image-cell" data-index="{{idx}}" bindtap="removeImage">
        <image class="image-thumb" src="{{item}}" mode="aspectFill" lazy-load="true" />
        <view class="image-remove">×</view>
      </view>
    </view>
    <view wx:if="{{imagePaths.length}}" class="ocr-box">
      <view class="ocr-text">{{ocrStatus}}</view>
      <view class="ocr-actions">
        <view class="small-button" wx:if="{{!ocrLoading}}" bindtap="recognizeImage">识别文字</view>
        <view class="small-button" wx:if="{{ocrLoading}}" style="opacity:0.6">正在识别</view>
        <view class="small-button direct-button" wx:if="{{!ocrLoading}}" bindtap="analyze">直接判断</view>
      </view>
    </view>
  </view>

  <view class="panel state-panel">
    <view class="panel-title">第二步：有没有做过危险操作？</view>
    <view class="panel-note">有就点一下，不确定可以不选。</view>
    <checkbox-group class="state-group" bindchange="onStateChange">
      <label wx:for="{{stateOptions}}" wx:key="value" class="state-item">
        <checkbox value="{{item.value}}" checked="{{selectedStatesMap[item.value]}}" color="#b52828" />
        <text>{{item.label}}</text>
      </label>
    </checkbox-group>
  </view>

  <view class="more-toggle" bindtap="toggleMoreOptions">
    <view>
      <view class="more-title">更多辅助信息</view>
      <view class="more-subtitle">能帮助判断更准，不填也可以。</view>
    </view>
    <text class="more-state">{{showMoreOptions ? "收起" : "可不填"}}</text>
  </view>

  <view class="more-options" wx:if="{{showMoreOptions}}">
    <view class="panel secondary-panel">
      <view class="panel-title">对方是怎么联系你的？</view>
      <view class="scenario-grid">
        <view wx:for="{{scenarioOptions}}" wx:key="value" class="scenario-card {{scenario === item.value ? 'is-selected' : ''}}" data-scenario="{{item.value}}" bindtap="selectScenario">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="final-action">
    <view class="primary-button {{loading ? 'is-loading' : ''}}" bindtap="analyze">
      {{loading ? "正在判断..." : "马上判断"}}
    </view>
    <view class="action-hint">不确定怎么填，也可以先判断。</view>
  </view>
</view>

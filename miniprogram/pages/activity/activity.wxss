.activity-page {
  min-height: 100vh;
  padding: 20rpx 16rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff6e8;
  color: #121815;
  overflow-x: hidden;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  overflow: hidden;
}

button::after {
  border: 0;
  display: none;
}

.activity-topbar,
.activity-brand,
.activity-hero,
.stamp-card,
.result-actions {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.activity-topbar {
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.activity-brand {
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.activity-brand > view,
.hero-copy,
.stamp-card > view:last-child {
  flex: 1;
  min-width: 0;
}

.activity-icon {
  width: 84rpx;
  height: 84rpx;
  border: 3rpx solid rgba(18, 24, 21, 0.12);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(18, 24, 21, 0.12);
  flex: 0 0 auto;
}

.activity-title {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-word;
}

.activity-subtitle {
  margin-top: 4rpx;
  color: #4e5b56;
  font-size: 26rpx;
  font-weight: 900;
}

.assistant-link,
.primary-action,
.share-action,
.assistant-wide {
  border-radius: 14rpx;
  font-weight: 900;
  line-height: 1.2;
}

.assistant-link {
  flex: 0 0 170rpx;
  min-width: 0;
  min-height: 78rpx;
  padding: 0 4rpx;
  border: 1rpx solid #cbd4cd;
  background: #ffffff;
  color: #034c49;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-hero,
.question-panel,
.result-panel {
  border: 4rpx solid rgba(210, 162, 58, 0.52);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(126, 69, 21, 0.1);
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.activity-hero {
  gap: 14rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #fffdf6;
}

.hero-duck {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  border: 3rpx solid rgba(210, 162, 58, 0.45);
  background: #fff8e5;
  flex: 0 0 auto;
}

.hero-kicker,
.question-meta {
  color: #8e1f1f;
  font-size: 28rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.32;
  word-break: break-word;
}

.hero-note,
.question-scene,
.explain-text,
.stamp-text,
.level-summary {
  color: #4e5b56;
  line-height: 1.55;
}

.hero-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  word-break: break-word;
}

.progress-panel {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 16rpx;
  width: 100%;
  overflow: hidden;
}

.progress-dot {
  min-height: 76rpx;
  border: 3rpx dashed rgba(210, 162, 58, 0.66);
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b6f18;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
  overflow: hidden;
}

.progress-dot.is-done {
  border-style: solid;
  background: #fff0ed;
  color: #8e1f1f;
}

.progress-dot.is-correct {
  background: #eaf8f3;
  border-color: rgba(4, 109, 104, 0.48);
  color: #034c49;
}

.question-panel,
.result-panel {
  padding: 18rpx;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.question-title {
  margin-top: 8rpx;
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
}

.question-scene {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fbfcfa;
  font-size: 29rpx;
  word-break: break-word;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
  width: 100%;
  overflow: hidden;
}

.option-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
  padding: 14rpx 8rpx;
  border: 3rpx solid #cbd4cd;
  border-radius: 18rpx;
  background: #ffffff;
  color: #121815;
  box-sizing: border-box;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.option-card.is-selected {
  border-color: #046d68;
  background: #eaf8f3;
}

.option-token {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.option-true {
  background: #046d68;
}

.option-fake {
  background: #b52828;
}

.option-text {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.explain-box {
  margin-top: 20rpx;
  padding: 14rpx;
  border: 3rpx solid rgba(210, 162, 58, 0.5);
  border-radius: 16rpx;
  background: #fff8e5;
}

.explain-box.is-good {
  border-color: rgba(4, 109, 104, 0.42);
  background: #eaf8f3;
}

.explain-box.is-warn {
  border-color: rgba(181, 40, 40, 0.34);
  background: #fff0ed;
}

.explain-title {
  font-size: 34rpx;
  font-weight: 900;
}

.explain-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  word-break: break-word;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin-top: 24rpx;
  border: 1rpx solid #034c49;
  background: #046d68;
  color: #ffffff;
  font-size: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-ribbon {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #b52828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.score-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 3rpx solid rgba(210, 162, 58, 0.58);
  border-radius: 18rpx;
  background: #fff8e5;
  text-align: center;
}

.score-number {
  color: #046d68;
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1;
}

.level-name {
  margin-top: 12rpx;
  color: #8e1f1f;
  font-size: 38rpx;
  font-weight: 900;
}

.level-summary {
  margin-top: 10rpx;
  font-size: 30rpx;
  word-break: break-word;
}

.stamp-card {
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 14rpx;
  border: 3rpx dashed rgba(181, 40, 40, 0.42);
  border-radius: 18rpx;
  background: #fff7f5;
}

.stamp-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 5rpx solid #b52828;
  border-radius: 50%;
  color: #b52828;
  font-size: 36rpx;
  font-weight: 900;
  flex: 0 0 auto;
  transform: rotate(-8deg);
}

.stamp-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.stamp-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  word-break: break-word;
}

.result-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
  width: 100%;
  overflow: hidden;
}

.primary-action.compact,
.share-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  margin-top: 0;
  padding: 0 12rpx;
  font-size: 29rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-action.compact {
  grid-column: 1 / -1;
}

.share-action {
  border: 1rpx solid #cbd4cd;
  background: #ffffff;
  color: #121815;
  width: 100%;
  min-width: 0;
}

.assistant-wide {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 84rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(210, 162, 58, 0.65);
  background: #fff8e5;
  color: #034c49;
  font-size: 29rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

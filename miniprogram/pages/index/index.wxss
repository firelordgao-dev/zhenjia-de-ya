.home-page {
  min-height: 100vh;
  padding: 20rpx 16rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff6e8;
  color: #121815;
  overflow-x: hidden;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  box-sizing: border-box;
  white-space: normal;
  overflow: hidden;
}

button::after {
  border: 0;
  display: none;
}

.hero {
  padding: 14rpx;
  border: 4rpx solid rgba(181, 40, 40, 0.18);
  border-radius: 20rpx;
  background: #fffdf6;
  box-shadow: 0 18rpx 36rpx rgba(126, 69, 21, 0.12);
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.hero-ribbon {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #b52828;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hero-icon {
  width: 108rpx;
  height: 108rpx;
  border: 3rpx solid rgba(210, 162, 58, 0.5);
  border-radius: 20rpx;
  background: #ffffff;
  flex: 0 0 auto;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-word;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #4e5b56;
  font-size: 30rpx;
  line-height: 1.45;
  word-break: break-word;
}

.hero-visual {
  width: 100%;
  height: 280rpx;
  margin-top: 16rpx;
  border: 4rpx solid rgba(210, 162, 58, 0.42);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #fff8e5;
  overflow: hidden;
}

.hero-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
  width: 100%;
}

.danger-button,
.plain-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 900;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.danger-button {
  border: 1rpx solid #8e1f1f;
  background: #b52828;
  color: #ffffff;
}

.plain-button {
  border: 1rpx solid #cbd4cd;
  background: #ffffff;
  color: #121815;
}

.emergency-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 4rpx dashed rgba(181, 40, 40, 0.34);
  border-radius: 18rpx;
  background: #fff7f1;
  box-shadow: 0 12rpx 26rpx rgba(181, 40, 40, 0.1);
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.emergency-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 5rpx solid #b52828;
  background: #ffffff;
  color: #b52828;
  font-size: 34rpx;
  font-weight: 900;
  flex: 0 0 auto;
  transform: rotate(-8deg);
}

.emergency-copy,
.intent-copy {
  flex: 1;
  min-width: 0;
}

.card-title,
.intent-title,
.safe-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.card-desc,
.intent-desc {
  margin-top: 6rpx;
  color: #4e5b56;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.intent-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
  width: 100%;
}

.intent-card {
  display: flex;
  justify-content: flex-start;
  gap: 12rpx;
  min-height: 128rpx;
  padding: 16rpx;
  border: 3rpx solid rgba(18, 24, 21, 0.1);
  border-radius: 18rpx;
  background: #ffffff;
  color: #121815;
  text-align: left;
  box-shadow: 0 10rpx 24rpx rgba(18, 24, 21, 0.06);
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.primary-intent {
  border-color: rgba(4, 109, 104, 0.42);
  background: #eff9f4;
}

.activity-intent {
  border-color: rgba(210, 162, 58, 0.62);
  background: #fff8e5;
}

.intent-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #046d68;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.public-symbol {
  background: #eaf8f3;
  color: #034c49;
  border: 2rpx solid rgba(4, 109, 104, 0.22);
}

.intent-arrow {
  color: #8e1f1f;
  font-size: 56rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.safe-note {
  margin-top: 18rpx;
  padding: 16rpx;
  border: 3rpx solid rgba(4, 109, 104, 0.2);
  border-radius: 18rpx;
  background: #eaf8f3;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.activity-section {
  margin-top: 18rpx;
}

.safe-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
  width: 100%;
}

.safe-item {
  padding: 12rpx;
  border: 3rpx dashed rgba(4, 109, 104, 0.22);
  border-radius: 16rpx;
  background: #ffffff;
  color: #034c49;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
  word-break: break-word;
}

@media (min-width: 760px) {
  .safe-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

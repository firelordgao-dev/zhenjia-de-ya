<view class="home-page">
  <view class="hero">
    <view class="hero-ribbon">公益反诈活动助手</view>
    <view class="hero-top">
      <image class="hero-icon" src="/assets/icon-duck-minjin-192.png" mode="aspectFill" />
      <view class="hero-copy">
        <view class="hero-title">真的假的鸭</view>
        <view class="hero-subtitle">转账、验证码、屏幕共享之前，先停下问一问。</view>
      </view>
    </view>
    <image class="hero-visual" src="/assets/activity-guide-duck.jpg" mode="aspectFill" />
    <view class="hero-actions">
      <view class="danger-button" bindtap="callPolice">拨打 110</view>
      <view class="plain-button" bindtap="callAntiFraud">咨询 96110</view>
    </view>
  </view>

  <view class="emergency-card" bindtap="goEmergencyCheck">
    <view class="emergency-mark">停</view>
    <view class="emergency-copy">
      <view class="card-title">已经转账、给码或共享屏幕？</view>
      <view class="card-desc">先看止损步骤，再判断真假。</view>
    </view>
  </view>

  <view class="intent-list">
    <view class="intent-card primary-intent" bindtap="goCheck">
      <text class="intent-symbol">判</text>
      <view class="intent-copy">
        <view class="intent-title">马上判断</view>
        <view class="intent-desc">粘贴聊天、短信、链接，或上传截图。</view>
      </view>
      <text class="intent-arrow">›</text>
    </view>

  </view>

  <view class="safe-note">
    <view class="safe-title">先记住三件事</view>
    <view class="safe-grid">
      <view class="safe-item">
        <text>不转钱</text>
      </view>
      <view class="safe-item">
        <text>不报码</text>
      </view>
      <view class="safe-item">
        <text>不共享屏幕</text>
      </view>
    </view>
  </view>

  <view class="activity-section">
    <view class="intent-card activity-intent" bindtap="goActivityChallenge">
      <text class="intent-symbol public-symbol">学</text>
      <view class="intent-copy">
        <view class="intent-title">公益反诈小测</view>
        <view class="intent-desc">5 个常见场景，现场学习用，不收费、不留隐私。</view>
      </view>
      <text class="intent-arrow">›</text>
    </view>
  </view>
</view>
